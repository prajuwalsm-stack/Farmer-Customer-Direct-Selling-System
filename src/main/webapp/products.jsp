<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,com.farmdirect.model.*,com.farmdirect.model.User" %><%List<Product> products=(List<Product>)request.getAttribute("products");User u=(User)session.getAttribute("user");%><!DOCTYPE html><html><head><title>Products</title><link rel="stylesheet" href="assets/style.css"><script src="assets/app.js"></script></head><body><header><a class="brand" href="index.jsp">🌱 FarmDirect</a><nav><a href="cart">Cart</a><%if(u!=null){%><a href="orders">Orders</a><a href="logout">Logout</a><%}else{%><a href="login.jsp">Login</a><%}%></nav></header><div class="container"><h2>Fresh farm products</h2><form method="get" action="products"><input name="search" placeholder="Search by product or category" value="<%=request.getParameter("search")==null?"":request.getParameter("search")%>"><button>Search</button></form><input id="localSearch" onkeyup="filterCards()" placeholder="Filter visible results..."><div class="grid"><%if(products!=null)for(Product x:products){%><div class="card" data-product><h3><%=x.getName()%></h3><p class="muted"><%=x.getCategory()%> · Farmer: <%=x.getFarmerName()%></p><p><%=x.getDescription()==null?"":x.getDescription()%></p><p class="price">₹ <%=String.format("%.2f",x.getPrice())%> / unit</p><p>Available: <%=x.getStock()%></p><%if(x.getStock()>0){%><form method="post" action="cart"><input type="hidden" name="id" value="<%=x.getId()%>"><input type="hidden" name="quantity" value="1"><button>Add to cart</button></form><%}else{%><span class="muted">Out of stock</span><%}%></div><%}%></div><%if(products==null||products.isEmpty()){%><p>No products found. Please check back later.</p><%}%></div></body></html>