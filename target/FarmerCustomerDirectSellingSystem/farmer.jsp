<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,com.farmdirect.model.*" %><%List<Product> products=(List<Product>)request.getAttribute("products");%><!DOCTYPE html><html><head><title>Farmer Dashboard</title><link rel="stylesheet" href="assets/style.css"><script src="assets/app.js"></script></head><body><header><a class="brand" href="index.jsp">🌱 FarmDirect</a><nav><a href="products">Marketplace</a><a href="logout">Logout</a></nav></header><div class="container"><h2>Farmer Dashboard</h2><div class="panel"><h3>Add a product</h3><form method="post" action="farmer"><input type="hidden" name="id" value="0"><div class="grid"><div><label>Product name</label><input name="name" required></div><div><label>Category</label><select name="category"><option>Vegetables</option><option>Fruits</option><option>Grains</option><option>Pulses</option><option>Other</option></select></div><div><label>Price (₹ per unit)</label><input type="number" name="price" min="0.01" step="0.01" required></div><div><label>Stock quantity</label><input type="number" name="stock" min="0" required></div></div><label>Description</label><textarea name="description"></textarea><button>Save Product</button></form></div><h3>Your products – update or delete</h3><div class="grid"><%if(products!=null)for(Product x:products){%><div class="card"><form method="post" action="farmer"><input type="hidden" name="id" value="<%=x.getId()%>"><label>Product name</label><input name="name" value="<%=x.getName()%>" required><label>Category</label><select name="category"><option <%= "Vegetables".equals(x.getCategory())?"selected":"" %>>Vegetables</option><option <%= "Fruits".equals(x.getCategory())?"selected":"" %>>Fruits</option><option <%= "Grains".equals(x.getCategory())?"selected":"" %>>Grains</option><option <%= "Pulses".equals(x.getCategory())?"selected":"" %>>Pulses</option><option <%= "Other".equals(x.getCategory())?"selected":"" %>>Other</option></select><label>Price (₹)</label><input type="number" name="price" min="0.01" step="0.01" value="<%=x.getPrice()%>" required><label>Stock</label><input type="number" name="stock" min="0" value="<%=x.getStock()%>" required><label>Description</label><textarea name="description"><%=x.getDescription()==null?"":x.getDescription()%></textarea><button>Update Product</button></form><form method="post" action="farmer" onsubmit="return confirmAction('Delete this product?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=x.getId()%>"><button class="danger">Delete Product</button></form></div><%}%></div><%if(products==null||products.isEmpty()){%><p>No products listed yet.</p><%}%></div></body></html>