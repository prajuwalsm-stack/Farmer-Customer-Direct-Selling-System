<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%List<Map<String,Object>> orders=(List<Map<String,Object>>)request.getAttribute("orders");%><!DOCTYPE html><html><head><title>Admin</title><link rel="stylesheet" href="assets/style.css"></head><body><header><a class="brand" href="index.jsp">🌱 FarmDirect Admin</a><a href="logout">Logout</a></header><div class="container"><h2>Admin Dashboard – Order Management</h2><div class="panel"><table><tr><th>Order</th><th>Customer</th><th>Date</th><th>Total</th><th>Status</th><th>Update</th></tr><%if(orders!=null)for(Map<String,Object> m:orders){%><tr><td>#<%=m.get("id")%></td><td><%=m.get("customer")%></td><td><%=m.get("date")%></td><td>₹<%=m.get("total")%></td><td><%=m.get("status")%></td><td><form method="post" action="admin"><input type="hidden" name="id" value="<%=m.get("id")%>"><select name="status"><option>PLACED</option><option>ACCEPTED</option><option>PACKED</option><option>COMPLETED</option><option>CANCELLED</option></select><button>Update</button></form></td></tr><%}%></table></div></div></body></html>