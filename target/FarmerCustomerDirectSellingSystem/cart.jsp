<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,com.farmdirect.model.*" %><%List<Map<String,Object>> items=(List<Map<String,Object>>)request.getAttribute("items");%><!DOCTYPE html><html><head><title>Cart</title><link rel="stylesheet" href="assets/style.css"></head><body><header><a class="brand" href="index.jsp">🌱 FarmDirect</a><a href="products">Continue shopping</a></header><div class="container"><h2>Shopping Cart</h2><%if(session.getAttribute("message")!=null){%><div class="notice"><%=session.getAttribute("message")%></div><%session.removeAttribute("message");}%><div class="panel"><table><tr><th>Product</th><th>Quantity</th><th>Subtotal</th><th></th></tr><%if(items!=null)for(Map<String,Object> m:items){Product x=(Product)m.get("product");%><tr><td><%=x.getName()%></td><td><%=m.get("quantity")%></td><td>₹<%=m.get("subtotal")%></td><td><form method="post" action="cart"><input type="hidden" name="action" value="remove"><input type="hidden" name="id" value="<%=x.getId()%>"><button class="danger">Remove</button></form></td></tr><%}%></table><h3>Total: ₹<%=request.getAttribute("total")%></h3><form method="post" action="checkout"><button>Place Order</button></form></div></div></body></html>