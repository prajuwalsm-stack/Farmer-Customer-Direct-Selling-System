<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%List<Map<String,Object>> orders=(List<Map<String,Object>>)request.getAttribute("orders");%><!DOCTYPE html><html><head><title>My Orders</title><link rel="stylesheet" href="assets/style.css"></head><body><header><a class="brand" href="index.jsp">🌱 FarmDirect</a><nav><a href="products">Shop</a><a href="logout">Logout</a></nav></header><div class="container"><h2>My Orders</h2><div class="panel"><table><tr><th>Order ID</th><th>Date</th><th>Total</th><th>Status</th></tr><%if(orders!=null)for(Map<String,Object> m:orders){%><tr><td>#<%=m.get("id")%></td><td><%=m.get("date")%></td><td>₹<%=m.get("total")%></td><td><%=m.get("status")%></td></tr><%}%></table><%if(orders==null||orders.isEmpty()){%><p>You have not placed any orders yet.</p><%}%></div></div></body></html>